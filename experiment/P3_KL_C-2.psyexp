        <Param name="colorSpace" val="rgb" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="None"/>
        <Param name="stopVal" val="" valType="code" updates="None"/>
        <Param name="forceNonSlip" val="False" valType="code" updates="None"/>
        <Param name="backgroundFit" val="none" valType="str" updates="None"/>
        <Param name="backgroundImg" val="" valType="str" updates="None"/>
      </RoutineSettingsComponent>
      <CodeComponent name="lsl_rating" plugin="None">
        <Param name="Before Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="Each Frame" val="lbk.poll(tracker=klc_gaze_source)" valType="extendedCode" updates="constant"/>
        <Param name="End Routine" val="&#10;if rating_resp.keys:&#10;    rt_value = rating_resp.rt if rating_resp.rt is not None else -1.0&#10;    lbk.marker('resp|q=SAM_AROUSAL_ROBOCZE|key=' + str(rating_resp.keys) + '|rt=' + str(round(float(rt_value), 3)))" valType="extendedCode" updates="constant"/>
        <Param name="End Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Code Type" val="Py" valType="str" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="name" val="lsl_rating" valType="code" updates="None"/>
      </CodeComponent>
      <TextComponent name="pytanie" plugin="None">
        <Param name="name" val="pytanie" valType="code" updates="None"/>
        <Param name="text" val="Ocena po bloku (roboczy element SAM):\nJak silne pobudzenie odczuwalas/es podczas ogladania obrazow?\n1 = bardzo male, 9 = bardzo silne. Wybierz klawisz 1-9." valType="str" updates="constant"/>
        <Param name="color" val="white" valType="color" updates="constant"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="constant"/>
        <Param name="pos" val="(0,0)" valType="list" updates="constant"/>
        <Param name="letterHeight" val="37" valType="num" updates="constant"/>
        <Param name="wrapWidth" val="1500" valType="num" updates="constant"/>
        <Param name="font" val="Arial" valType="str" updates="constant"/>
        <Param name="ori" val="0" valType="num" updates="constant"/>
        <Param name="opacity" val="1" valType="num" updates="constant"/>
        <Param name="contrast" val="1" valType="num" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0.0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="" valType="code" updates="constant"/>
        <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant"/>
        <Param name="units" val="from exp settings" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="flip" val="None" valType="str" updates="constant"/>
      </TextComponent>
      <KeyboardComponent name="rating_resp" plugin="None">
        <Param name="name" val="rating_resp" valType="code" updates="None"/>
        <Param name="allowedKeys" val="'1','2','3','4','5','6','7','8','9'" valType="list" updates="constant"/>
        <Param name="correctAns" val="" valType="str" updates="constant"/>
        <Param name="forceEndRoutine" val="True" valType="bool" updates="constant"/>
        <Param name="store" val="last key" valType="str" updates="constant"/>
        <Param name="storeCorrect" val="False" valType="bool" updates="constant"/>
        <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="" valType="code" updates="constant"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="discard previous" val="True" valType="bool" updates="constant"/>
        <Param name="registerOn" val="press" valType="str" updates="constant"/>
      </KeyboardComponent>
    </Routine>
    <Routine name="monitoring">
      <RoutineSettingsComponent name="monitoring" plugin="None">
        <Param name="name" val="monitoring" valType="code" updates="None"/>
        <Param name="color" val="0" valType="color" updates="None"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="None"/>
        <Param name="stopVal" val="" valType="code" updates="None"/>
        <Param name="forceNonSlip" val="False" valType="code" updates="None"/>
        <Param name="backgroundFit" val="none" valType="str" updates="None"/>
        <Param name="backgroundImg" val="" valType="str" updates="None"/>
      </RoutineSettingsComponent>
      <CodeComponent name="lsl_monitoring" plugin="None">
        <Param name="Before Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin Routine" val="lbk.marker('block:start|block=monitoring_klc')" valType="extendedCode" updates="constant"/>
        <Param name="Each Frame" val="lbk.poll(tracker=klc_gaze_source)" valType="extendedCode" updates="constant"/>
        <Param name="End Routine" val="lbk.marker('block:end|block=monitoring_klc')" valType="extendedCode" updates="constant"/>
        <Param name="End Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Code Type" val="Py" valType="str" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="name" val="lsl_monitoring" valType="code" updates="None"/>
      </CodeComponent>
      <TextComponent name="tekst_monitoring" plugin="None">
        <Param name="name" val="tekst_monitoring" valType="code" updates="None"/>
        <Param name="text" val="Etap techniczny KL-C (340 s).&#10;Pozostan przy ekranie.&#10;Mozesz poruszac mysza i symulowac mrugniecia srodkowym przyciskiem." valType="str" updates="constant"/>
        <Param name="color" val="white" valType="color" updates="constant"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="constant"/>
        <Param name="pos" val="(0,0)" valType="list" updates="constant"/>
        <Param name="letterHeight" val="28" valType="num" updates="constant"/>
        <Param name="wrapWidth" val="1200" valType="num" updates="constant"/>
        <Param name="font" val="Arial" valType="str" updates="constant"/>
        <Param name="ori" val="0" valType="num" updates="constant"/>
        <Param name="opacity" val="1" valType="num" updates="constant"/>
        <Param name="contrast" val="1" valType="num" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0.0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="340.0" valType="code" updates="constant"/>
        <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant"/>
        <Param name="units" val="from exp settings" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="flip" val="None" valType="str" updates="constant"/>
      </TextComponent>
    </Routine>
    <Routine name="end">
      <RoutineSettingsComponent name="end" plugin="None">
        <Param name="name" val="end" valType="code" updates="None"/>
        <Param name="color" val="black" valType="color" updates="None"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="None"/>
        <Param name="stopVal" val="" valType="code" updates="None"/>
        <Param name="forceNonSlip" val="False" valType="code" updates="None"/>
        <Param name="backgroundFit" val="none" valType="str" updates="None"/>
        <Param name="backgroundImg" val="" valType="str" updates="None"/>
      </RoutineSettingsComponent>
      <CodeComponent name="lsl_end" plugin="None">
        <Param name="Before Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin Routine" val="lbk.marker('exp:end')" valType="extendedCode" updates="constant"/>
        <Param name="Each Frame" val="lbk.poll(tracker=klc_gaze_source)" valType="extendedCode" updates="constant"/>
        <Param name="End Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="End Experiment" val="lbk.close()" valType="extendedCode" updates="constant"/>
        <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Code Type" val="Py" valType="str" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="name" val="lsl_end" valType="code" updates="None"/>
      </CodeComponent>
      <TextComponent name="koniec" plugin="None">
        <Param name="name" val="koniec" valType="code" updates="None"/>
        <Param name="text" val="Koniec testu. Dziekujemy!" valType="str" updates="constant"/>
        <Param name="color" val="white" valType="color" updates="constant"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="constant"/>
        <Param name="pos" val="(0,0)" valType="list" updates="constant"/>
        <Param name="letterHeight" val="42" valType="num" updates="constant"/>
        <Param name="wrapWidth" val="1500" valType="num" updates="constant"/>
        <Param name="font" val="Arial" valType="str" updates="constant"/>
        <Param name="ori" val="0" valType="num" updates="constant"/>
        <Param name="opacity" val="1" valType="num" updates="constant"/>
        <Param name="contrast" val="1" valType="num" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0.0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="2" valType="code" updates="constant"/>
        <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant"/>
        <Param name="units" val="from exp settings" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="flip" val="None" valType="str" updates="constant"/>
      </TextComponent>
    <EyetrackerRecordComponent name="etStop" plugin="None">
        <Param name="name" val="etStop" valType="code" updates="None"/>
        <Param name="actionType" val="Stop Only" valType="str" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0.0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="" valType="code" updates="constant"/>
        <Param name="stopWithRoutine" val="False" valType="bool" updates="constant"/>
        <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
      </EyetrackerRecordComponent>
    </Routine>
  </Routines>
  <Flow><Routine name="intro"/>
    <Routine name="baseline"/><LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="name" val="trials" valType="code" updates="None"/>
      <Param name="nReps" val="1" valType="num" updates="None"/>
      <Param name="conditionsFile" val="conditions/L1_LBK_4obrazy_test.csv" valType="str" updates="None"/>
      <Param name="conditions" val="[]" valType="str" updates="None"/>
      <Param name="loopType" val="sequential" valType="str" updates="None"/>
      <Param name="random seed" val="" valType="code" updates="None"/>
      <Param name="Selected rows" val="" valType="str" updates="None"/>
      <Param name="isTrials" val="True" valType="bool" updates="None"/>
      <Param name="endPoints" val="[1,5]" valType="num" updates="None"/>
    </LoopInitiator>
    <Routine name="fixation"/>
    <Routine name="stimulus"/>
    <Routine name="gray"/>
    <LoopTerminator name="trials"/>
    <Routine name="rating"/>
    <Routine name="monitoring"/><Routine name="end"/>
  </Flow></PsychoPy2experiment>
