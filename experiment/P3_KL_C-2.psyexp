<?xml version='1.0' encoding='UTF-8'?>
<PsychoPy2experiment encoding="utf-8" version="2025.1.0">
  <Settings>
    <Param name="expName" val="P3_KL_C" valType="str" updates="None"/>
    <Param name="expVersion" val="KL-C-P3-diag-1" valType="str" updates="None"/>
    <Param name="Experiment info" val="{'participant':'TEST-01','session':'01'}" valType="code" updates="None"/>
    <Param name="Data filename" val="u'data' + os.sep + '%s_%s' % (expInfo['participant'], expInfo['date'])" valType="code" updates="None"/>
    <Param name="Full-screen window" val="False" valType="bool" updates="None"/>
    <Param name="Window size (pixels)" val="[1920,1080]" valType="code" updates="None"/>
    <Param name="Units" val="pix" valType="str" updates="None"/>
    <Param name="Screen" val="1" valType="num" updates="None"/>
    <Param name="Monitor" val="testMonitor" valType="str" updates="None"/>
    <Param name="Show mouse" val="True" valType="bool" updates="None"/>
    <Param name="Enable Escape" val="True" valType="bool" updates="None"/>
    <Param name="color" val="black" valType="str" updates="None"/>
    <Param name="colorSpace" val="rgb" valType="str" updates="None"/>
    <Param name="Save wide csv file" val="True" valType="bool" updates="None"/>
    <Param name="Save excel file" val="True" valType="bool" updates="None"/>
    <Param name="Save psydat file" val="True" valType="bool" updates="None"/>
    <Param name="Save log file" val="True" valType="bool" updates="None"/>
    <Param name="Save hdf5 file" val="True" valType="bool" updates="None"/>
    <Param name="eyetracker" val="eyetracker.hw.mouse.EyeTracker" valType="str" updates="None"/>
    <Param name="mgBlink" val="['MIDDLE_BUTTON']" valType="list" updates="None"/>
    <Param name="mgMove" val="CONTINUOUS" valType="str" updates="None"/>
    <Param name="mgSaccade" val="0.5" valType="num" updates="None"/>
    <Param name="frameRate" val="" valType="code" updates="None"/>
    <Param name="Show info dlg" val="True" valType="bool" updates="None"/>
    <Param name="logging level" val="warning" valType="code" updates="None"/>
    <Param name="consoleLoggingLevel" val="warning" valType="code" updates="None"/>
    <Param name="keyboardBackend" val="ioHub" valType="str" updates="None"/>
    <Param name="winBackend" val="pyglet" valType="str" updates="None"/>
    <Param name="runMode" val="1" valType="code" updates="None"/>
    <Param name="sortColumns" val="time" valType="str" updates="None"/>
    <Param name="Data file delimiter" val="auto" valType="str" updates="None"/>
    <Param name="Audio lib" val="use prefs" valType="str" updates="None"/>
    <Param name="Audio latency priority" val="use prefs" valType="str" updates="None"/>
    <Param name="Force stereo" val="True" valType="bool" updates="None"/>
  </Settings>
  <Routines>
    <Routine name="intro">
      <RoutineSettingsComponent name="intro" plugin="None">
        <Param name="name" val="intro" valType="code" updates="None"/>
        <Param name="color" val="black" valType="color" updates="None"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="None"/>
        <Param name="stopVal" val="" valType="code" updates="None"/>
        <Param name="forceNonSlip" val="False" valType="code" updates="None"/>
        <Param name="backgroundFit" val="none" valType="str" updates="None"/>
        <Param name="backgroundImg" val="" valType="str" updates="None"/>
      </RoutineSettingsComponent>
      <CodeComponent name="lsl_intro" plugin="None">
        <Param name="Before Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin Experiment" val="from lsl_runtime import LBKMonitor&#10;from psychopy import event as klc_event&#10;from pylsl import local_clock as klc_clock&#10;from types import SimpleNamespace as klc_sample&#10;&#10;class KLCPointerGaze:&#10;    &quot;&quot;&quot;Lokalna kontrola jakosci MouseGaze przez cala sesje.&#10;&#10;    MouseGaze (ioHub) nadal zapisuje dane w etRecord podczas pokazu obrazu.&#10;    Poza ta routine jego getLastSample() zwraca None, wiec tutaj&#10;    obserwujemy kursor niezaleznie od tego, czy etRecord nagrywa.&#10;    To symulacja wzroku na komputerze, NIE pomiar rzeczywistego oka.&#10;    &quot;&quot;&quot;&#10;    def __init__(self, window):&#10;        self.window = window&#10;        self.mouse = klc_event.Mouse(win=window)&#10;&#10;    def getLastSample(self):&#10;        try:&#10;            xy = self.mouse.getPos()&#10;            buttons = self.mouse.getPressed()&#10;            x, y = float(xy[0]), float(xy[1])&#10;            width, height = self.window.size&#10;            # pix: (0, 0) w srodku okna; przycisk oznacza artefakt/mrugniecie.&#10;            valid = (-width / 2 &lt;= x &lt;= width / 2 and&#10;                     -height / 2 &lt;= y &lt;= height / 2 and&#10;                     not any(buttons))&#10;            return klc_sample(time=klc_clock(), gaze_x=x, gaze_y=y,&#10;                              status=0 if valid else 2)&#10;        except (AttributeError, TypeError, ValueError, IndexError):&#10;            return None&#10;&#10;lbk = LBKMonitor(participant=expInfo['participant'])&#10;klc_gaze_source = KLCPointerGaze(win)&#10;" valType="extendedCode" updates="constant"/>
        <Param name="Begin Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="Each Frame" val="lbk.poll(tracker=klc_gaze_source)" valType="extendedCode" updates="constant"/>
        <Param name="End Routine" val="lbk.marker('exp:start|study=P3|list=L1_LBK_4obrazy_test|stage=KL-C')" valType="extendedCode" updates="constant"/>
        <Param name="End Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Begin JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Routine" val="" valType="extendedCode" updates="constant"/>
        <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant"/>
        <Param name="Code Type" val="Py" valType="str" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="name" val="lsl_intro" valType="code" updates="None"/>
      </CodeComponent>
      <TextComponent name="instrukcja" plugin="None">
        <Param name="name" val="instrukcja" valType="code" updates="None"/>
        <Param name="text" val="P3 - Qualia, barwa i subiektywne doswiadczenie\nTest jednego bloku z czterema obrazami LBK.\nOgladaj obrazy swobodnie. Po bloku ocen pobudzenie w skali 1-9.\nNacisnij spacje, aby zaczac." valType="str" updates="constant"/>
        <Param name="color" val="white" valType="color" updates="constant"/>
        <Param name="colorSpace" val="rgb" valType="str" updates="constant"/>
        <Param name="pos" val="(0,0)" valType="list" updates="constant"/>
        <Param name="letterHeight" val="38" valType="num" updates="constant"/>
        <Param name="wrapWidth" val="1500" valType="num" updates="constant"/>
        <Param name="font" val="Arial" valType="str" updates="constant"/>
        <Param name="ori" val="0" valType="num" updates="constant"/>
        <Param name="opacity" val="1" valType="num" updates="constant"/>
        <Param name="contrast" val="1" valType="num" updates="constant"/>
        <Param name="startType" val="time (s)" valType="str" updates="constant"/>
        <Param name="startVal" val="0.0" valType="code" updates="constant"/>
        <Param name="stopType" val="duration (s)" valType="str" updates="constant"/>
        <Param name="stopVal" val="" valType="code" updates="constant"/>
        <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant"/>
        <Param name="units" val="from exp settings" valType="str" updates="None"/>
        <Param name="saveStartStop" val="True" valType="bool" updates="None"/>
        <Param name="disabled" val="False" valType="bool" updates="None"/>
        <Param name="flip" val="None" valType="str" updates="constant"/>
      </TextComponent>
